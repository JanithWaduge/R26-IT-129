APP_NAME=SLSL-BAMS API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
DOCS_ENABLED=true
RUN_MIGRATIONS_ON_STARTUP=true
FORCE_HTTPS=false
TRUSTED_HOSTS=["localhost","127.0.0.1"]
CORS_ALLOWED_ORIGINS=["http://localhost"]
API_V1_PREFIX=/api/v1

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=slsl_bams_dev
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
DROP_DATABASE_ON_SHUTDOWN=false

JWT_ACCESS_SECRET=GENERATE_A_RANDOM_SECRET
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=slsl-bams-api
JWT_AUDIENCE=slsl-bams-mobile
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

QUIZ_SESSION_DURATION_MINUTES=60
QUIZ_MAX_RETRIES=2
QUIZ_OPTION_COUNT=4
PRODUCTIVE_ACCEPTANCE_CONFIDENCE=0.70

MASTERY_ALGORITHM_VERSION=bams-mastery-v1
MASTERY_INITIAL_LEARNING_RATE=0.45
MASTERY_INTERMEDIATE_LEARNING_RATE=0.30
MASTERY_STABLE_LEARNING_RATE=0.20
MASTERY_FAILURE_LEARNING_RATE=0.45

SM2_ALGORITHM_VERSION=bams-sm2-v1
SM2_INITIAL_EASE_FACTOR=2.50
SM2_MIN_EASE_FACTOR=1.30
SM2_MAX_EASE_FACTOR=3.20
SM2_MAX_INTERVAL_DAYS=365
GAMIFICATION_XP_PER_LEVEL=250
GAMIFICATION_TIMEZONE=Asia/Colombo

ML_PSEUDONYM_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

ML_DATASET_SCHEMA_VERSION=slsl-receptive-recall-v1

ML_MIN_RECALL_DELAY_HOURS=24
ML_MAX_RECALL_DELAY_DAYS=30

ML_EXPORT_DIRECTORY=outputs/ml_datasets

ML_MIN_TRAINING_ROWS=100
ML_MIN_CLASS_ROWS=20
ML_SCHEDULER_ENABLED=false
ML_MODEL_PATH=outputs/models/receptive_recall/recall_model_champion.joblib
ML_MODEL_METADATA_PATH=outputs/models/receptive_recall/model_metadata.json
ML_ALLOW_SYNTHETIC_MODEL=false
ML_REQUIRE_EXACT_SKLEARN_VERSION=true
ML_MIN_INTERVAL_FACTOR=0.50
ML_MAX_INTERVAL_FACTOR=1.15
EXPERIMENT_ENABLED=false
EXPERIMENT_NAME=slsl-scheduler-comparison-v1
EXPERIMENT_ASSIGNMENT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
EXPERIMENT_MIN_RECALL_DELAY_HOURS=24
EXPERIMENT_MAX_RECALL_DELAY_DAYS=30
EXPERIMENT_BOOTSTRAP_ITERATIONS=2000
EXPERIMENT_MIN_LEARNERS_PER_ARM=15
EXPERIMENT_OUTPUT_DIRECTORY=outputs/evaluations
RESEARCH_REPORT_OUTPUT_DIRECTORY=outputs/research_reports
RESEARCH_REPORT_TITLE=SLSL-BAMS Scheduler Evaluation
RESEARCH_REPORT_INCLUDE_RAW_LABELS=false
AUDIT_RETENTION_DAYS=365
RESEARCH_RETENTION_DAYS=730
