ENVIRONMENT=test
APP_VERSION=1.0.0
DEBUG=false
DOCS_ENABLED=false
RUN_MIGRATIONS_ON_STARTUP=true
FORCE_HTTPS=false
TRUSTED_HOSTS=["testserver","localhost","127.0.0.1"]
CORS_ALLOWED_ORIGINS=["http://testserver"]
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=slsl_bams_test
JWT_ACCESS_SECRET=test-access-secret-at-least-64-characters-long-00000000000000000000
JWT_REFRESH_SECRET=test-refresh-secret-at-least-64-characters-long-0000000000000000000
ML_SCHEDULER_ENABLED=false
ML_ALLOW_SYNTHETIC_MODEL=false
EXPERIMENT_ENABLED=false
RECOGNITION_RETAIN_UPLOADS=false
