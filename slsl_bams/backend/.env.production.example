ENVIRONMENT=production
APP_VERSION=1.0.0
DEBUG=false
DOCS_ENABLED=false
RUN_MIGRATIONS_ON_STARTUP=false
FORCE_HTTPS=true
TRUSTED_HOSTS=["api.example.com"]
CORS_ALLOWED_ORIGINS=["https://app.example.com"]
MONGO_URI=
MONGO_DATABASE=slsl_bams
JWT_ACCESS_SECRET=
